# ===================================================
# VERDICT: Claim Verification & Evidence Analysis — Environment Configuration
# ===================================================

# Entailment LLM Provider
# Options: 'groq', 'openai', 'gemini', or leave empty for offline heuristic NLI fallback
LLM_PROVIDER=

# Groq Configuration (Fastest Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Backend API Configuration
BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.25
